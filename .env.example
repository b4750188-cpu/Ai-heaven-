# ==============================================================================
# AI HEAVEN - PRODUCTION ENVIRONMENT VARIABLES (VERCEL DEPLOYMENT)
# All sensitive secrets must be placed into Vercel Environment Variables (Settings > Environment Variables).
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

# DATABASE_URL (Server-Only Secret):
# PostgreSQL connection string for production database (e.g., Supabase, Neon, AWS RDS, Cloud SQL).
# Server-side only - NEVER prefix with VITE_ or expose to client bundles.
# Example: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require
DATABASE_URL=""

# JWT_SECRET_KEY (Server-Only Secret):
# Cryptographic 256-bit secret key used to sign and verify HS256 JWT tokens for RBAC.
# Server-side only - NEVER prefix with VITE_ or expose to client bundles.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=""

# ALLOWED_ORIGINS (Server-Side Configuration):
# Comma-separated list of allowed CORS origins for production.
# Wildcard matching *.vercel.app is automatically supported by AI Heaven server middleware.
ALLOWED_ORIGINS="https://ais-dev-zrhpytvpqxxvopx2vzwyfz-959964077611.asia-southeast1.run.app,https://ais-pre-zrhpytvpqxxvopx2vzwyfz-959964077611.asia-southeast1.run.app"

# Note on VITE_API_URL:
# Decommissioned. In production and local development, the frontend client natively queries same-origin '/api' endpoints, eliminating CORS friction and preventing host mismatch errors.


