# ==============================================================================
# AI HEAVEN - INTERNAL SERVER CONFIGURATION VARIABLES
# ZERO third-party API keys required from users.
# ==============================================================================

# VITE_API_URL: Client-visible base URL for AI Heaven REST API endpoints.
# Defaults to '/api' for same-origin proxy in development & production.
VITE_API_URL="/api"

# DATABASE_URL: PostgreSQL connection string for production SQLAlchemy/asyncpg backend.
# Internal server secret - NEVER expose to browser bundles.
# Leave empty for local in-memory fallback.
# Example: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=""

# JWT_SECRET_KEY: Cryptographic secret key for signing and verifying HS256 JWT tokens.
# Internal server secret - NEVER expose to browser bundles.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=""

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for browser security.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://ais-dev-zrhpytvpqxxvopx2vzwyfz-959964077611.asia-southeast1.run.app,https://ais-pre-zrhpytvpqxxvopx2vzwyfz-959964077611.asia-southeast1.run.app"


