# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Base URL for AI Heaven API (defaults to /api in full-stack express/vite server)
VITE_API_URL="/api"

# DATABASE_URL: PostgreSQL connection string for production SQLAlchemy backend
DATABASE_URL="postgresql+asyncpg://ai_heaven_user:password@localhost:5432/ai_heaven"

# JWT_SECRET_KEY: Secret key for signing and verifying JWT tokens in production FastAPI backend
JWT_SECRET_KEY="replace_with_secure_random_production_secret"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

